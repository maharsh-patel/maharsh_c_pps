#include <stdio.h>
int findmax(int a, int b, int c) {
	int max = a;
	if(b >max) {
		max = b;
	}
	if(c>max) {
		max = c;
	}
	return max;
}
int main() {
	int a,b,c;
	printf("enter three numbers :\n");
	printf("a= ");
	scanf("%d",&a);
	printf("b= ");
	scanf("%d",&b);
	printf("c= ");
	scanf("%d",&c);
	int max = findmax(a, b, c);
	printf("The maximum numbernis: %d\n",max);
	return 0;
}