
#include <stdio.h>

int main()
{
	int a[10];
	for(int i=0; i<10; i++) {
		printf("enter %d number=",i);
		scanf("%d",&a[i]);
	}
	int sum=0;
	int multi=1;
	for(int i=0; i<10; i++) {
		sum=sum+a[i];
		multi=multi*a[i];
	}

	printf("the sum of array is=%d\n",sum);
	printf("the multiplication of array is=%d",multi);


	return 0;
}