#include <stdio.h>

int main()
{
	float a[10];
	for(int i=0; i<10; i++) {
		printf("enter %d number=",i);
		scanf("%f",&a[i]);
	}
	float sum=0;
	float multi=1;
	for(int i=0; i<10; i++) {
		sum=sum+a[i];
		multi=multi*a[i];
	}

	printf("the sum of array is=%f\n",sum);
	printf("the multiplication of array is=%f",multi);


	return 0;
}